# Copy to .env (gitignored) and fill in. docker compose loads .env automatically.

# --- OTEL Collector ---
# Bearer token the collector requires on its OTLP receivers (gRPC 4317 / HTTP 4318).
# MUST be non-empty, or the collector fails to start.
# Clients must send the same value as: Authorization=Bearer <token>
# Generate with: openssl rand -hex 32
OTEL_AUTH_TOKEN=

# --- Grafana admin ---
# Only applied on the FIRST start of a fresh grafana_data volume; ignored afterwards
# (a password changed in the Grafana UI persists in the volume).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# --- Keycloak SSO for Grafana (OIDC) ---
# Leave KEYCLOAK_ENABLED=false until the rest is filled in; Grafana keeps the local
# admin login working regardless (break-glass). Flip to true to turn SSO on.
KEYCLOAK_ENABLED=false
# Base URL of your Keycloak (no trailing slash) and the realm name.
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=your-org
# Confidential OAuth client in Keycloak (uses client roles grafana-admin / grafana-viewer).
#   Valid redirect URI to set in Keycloak:
#   https://grafana.claude-analytics.example.com/login/generic_oauth
KEYCLOAK_CLIENT_ID=claude-code-analytics
KEYCLOAK_CLIENT_SECRET=

# --- prompt-intent-classifier (labeling / quality scoring) ---
# Loaded via: set -a; . ../.env; set +a  (run from prompt-intent-classifier/)
# ANTHROPIC_API_KEY is used if set; OPENAI_API_KEY is the fallback provider
# for score_quality.py (SCORER_PROVIDER=auto picks whichever key is present).
# At least one of the two is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Postgres (prompt-store-exporter: raw prompt content, queryable per user) ---
# Generate a password with: openssl rand -hex 16
POSTGRES_USER=tokenguard
POSTGRES_PASSWORD=
POSTGRES_DB=tokenguard

# --- billing-exporter ---
# The Anthropic Admin API key is NOT an env var; it is mounted from a file.
# Create it before deploying:
#   mkdir -p .secrets && umask 077 && printf '%s' 'sk-ant-admin-...' > .secrets/admin-key
# And copy the roster:
#   cp billing-exporter/seat-roster.example.yaml billing-exporter/seat-roster.yaml
