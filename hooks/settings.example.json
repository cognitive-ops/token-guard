{
  "_comment": "Copy the env + hooks blocks into .claude/settings.json (project), or into managed-settings.json for org-wide rollout. $CLAUDE_PROJECT_DIR resolves to the repo root; for managed rollout use an absolute path like /usr/local/lib/claude-hooks.",
  "env": {
    "CLAUDE_HOOK_LOKI_URL": "http://localhost:3100"
  },
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/log-prompt.sh", "timeout": 5 },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/lint-prompt.sh", "timeout": 5 }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash", "if": "Bash(git commit *)",
        "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/log-commit.sh", "timeout": 5 } ] },
      { "matcher": "Bash", "if": "Bash(gh pr create *)",
        "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/log-pr.sh", "timeout": 5 } ] },
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/log-edit.sh", "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/session-end.sh", "timeout": 5 } ] }
    ]
  }
}
