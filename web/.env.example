# Copy to .env.local for local dev. All vars are server-side only.

# Datasource URLs. Inside docker-compose use the service names; for local dev
# against a running stack use localhost (or the online relay ports — see
# prompt-explorer/online-tunnels.sh).
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# Default dashboard window (days) when no ?range= param is present.
DEFAULT_RANGE_DAYS=30

# --- API Cost dashboard (Anthropic Admin API) ---
# Billed cost per client (= workspace) for /api-cost. Provide the admin key
# inline OR as a mounted file path (like the billing-exporter). Server-only.
# Leave both unset to disable the page (it shows "not configured").
# ADMIN_KEY=sk-ant-admin-...
ADMIN_KEY_PATH=/secrets/admin-key

# Per-query timeout (ms) and result cache TTL (seconds).
# Analytics tolerate staleness, so the cache window is generous by default —
# raise it further to trade more freshness for fewer datasource round-trips.
QUERY_TIMEOUT_MS=15000
REVALIDATE_SECONDS=300

# --- Auth (Keycloak SSO + local break-glass login) ---
# Off by default: the dashboard runs open. Set true to require sign-in.
AUTH_ENABLED=false
# Signing secret for sessions (required when AUTH_ENABLED=true).
#   generate with: openssl rand -base64 32
AUTH_SECRET=

# Local break-glass login (the "separate local login button"). Always available
# unless disabled — the equivalent of Grafana's local admin.
LOCAL_LOGIN_ENABLED=true
LOCAL_USERNAME=admin
LOCAL_PASSWORD=admin

# Keycloak OIDC — same realm/client as the Grafana service in docker-compose.
# Valid redirect URI to register in Keycloak:
#   http://localhost:3001/api/auth/callback/keycloak  (and the prod origin)
KEYCLOAK_ENABLED=false
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=your-org
KEYCLOAK_CLIENT_ID=claude-code-analytics
KEYCLOAK_CLIENT_SECRET=
