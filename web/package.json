{
  "name": "claude-roi-web",
  "version": "0.1.0",
  "private": true,
  "description": "PoC Next.js view layer for the Claude Code ROI analytics stack (Prometheus + Loki).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
